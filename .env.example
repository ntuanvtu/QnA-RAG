# Sao chép file này thành `.env` rồi điền giá trị thật.
# KHÔNG commit file .env lên git.

# Bắt buộc để gọi LLM. Lấy key tại https://console.anthropic.com
ANTHROPIC_API_KEY=

# (Tuỳ chọn) ghi đè mặc định trong config.py
LLM_MODEL=claude-haiku-4-5
CONFIDENCE_THRESHOLD=0.35
TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
SPARSE_MEDIAN_THRESHOLD=700
SPARSE_BLOCK_CHARS=600
ENABLE_QUERY_REWRITE=true
SUMMARY_BATCH_CHARS=6000
SUMMARY_MAX_BATCHES=10
